  (text "2) MISURA CORRENTE + SWITCH VD (soft-start, scarica)" (at 171.45 27.94 0) (effects (font (size 2.0 2.0) (thickness 0.3) bold) (justify left bottom)) (uuid ec2383e2-48a5-4439-b5e1-5e1ee34e9423))
  (text "3) ALIMENTAZIONI BIAS: hold-up, +5V, -5V, rif. -3.6V" (at 25.4 149.86 0) (effects (font (size 2.0 2.0) (thickness 0.3) bold) (justify left bottom)) (uuid 54e28f9d-4578-4b25-8a7a-c657f2e5eb3f))
  (text "4) IMPOSTAZIONE VG + COMP. T + DRIVER GATE + PINCH-OFF" (at 317.5 149.86 0) (effects (font (size 2.0 2.0) (thickness 0.3) bold) (justify left bottom)) (uuid 9fbea790-89d4-4c27-bbbe-e18de6980454))
  (text "5) SUPERVISORE: UV/OV/OC/VG/VNEG/EN -> ENABLE ;  VD pronto & ENABLE -> GATE_REL" (at 25.4 281.94 0) (effects (font (size 2.0 2.0) (thickness 0.3) bold) (justify left bottom)) (uuid fca6289d-abed-41f0-b604-144082a2695d))
